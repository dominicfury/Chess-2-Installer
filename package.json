{
  "name": "chess2-app",
  "productName": "Chess 2",
  "version": "0.1.0",
  "description": "Chess, but every capture is a gunfight.",
  "author": "Chess 2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "electron . --server http://localhost:3210",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chess2.game",
    "productName": "Chess 2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "app-config.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chess 2",
      "uninstallDisplayName": "Chess 2",
      "artifactName": "Chess 2 Setup ${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false
    }
  }
}
