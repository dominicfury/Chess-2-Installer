{
  "name": "chess2-app",
  "productName": "Chess 2: Brainrot Edition",
  "version": "0.1.3",
  "description": "Chess 2: Brainrot Edition",
  "author": "Chess 2",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "electron . --server http://localhost:3210",
    "dist": "electron-builder --win nsis",
    "start:bundled": "electron ."
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chess2.game",
    "executableName": "Chess 2 Brainrot Edition",
    "productName": "Chess 2: Brainrot Edition",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "game/**/*",
      "preload.js",
      "offline.html",
      "app-config.json",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chess 2 Brainrot Edition",
      "uninstallDisplayName": "Chess 2: Brainrot Edition",
      "artifactName": "Chess-2-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dominicfury",
        "repo": "Chess-2-Installer"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
